{
  "name": "jev",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Winnow — Gmail organizer and LinkedIn de-slop, in one Chrome extension.",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test",
    "eval:heuristics": "tsx scripts/eval-heuristics.ts",
    "test:roar": "node scripts/test-roar.mjs",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "openai": "^7.62.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "@wxt-dev/module-react": "^1.2.2",
    "axe-core": "^4.14.1",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1",
    "wxt": "^0.21.5"
  },
  "engines": {
    "node": ">=20"
  }
}
